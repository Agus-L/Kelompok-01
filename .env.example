APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# APP_DEBUG=true
# Nilai konfigurasi APP_DEBUG pada berkas template .env.example diatur aktif (true), sehingga berisiko terbawa saat membuat environment server produksi yang akan membocorkan seluruh stack trace, variabel lingkungan, dan struktur database kepada pengguna luar saat terjadi error, yang seharusnya secara default bernilai aman yaitu false
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_CONNECTION=mysql
# DB_HOST=10.10.4.52
# DB_PORT=3306
# DB_DATABASE=kampuslms_prod
# DB_USERNAME=admin_lms
# DB_PASSWORD=P@ssw0rdProdLMS2026!
# Berkas .env.example memuat kredensial sensitif produksi nyata berupa alamat IP database internal, username, password produksi, serta Access Key dan Secret Key AWS S3, sehingga data rahasia dan infrastruktur server dapat dibobol dan disalahgunakan oleh pihak tidak berwenang saat kode di-push ke repositori publik/tim, yang seharusnya seluruh nilai sensitif tersebut dikosongkan atau diganti dengan nilai placeholder dummy.

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7PRODKEY
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYPRODSECRET
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=kampuslms-production-storage
# AWS_USE_PATH_STYLE_ENDPOINT=false
# Berkas .env.example memuat kredensial sensitif produksi nyata berupa alamat IP database internal, username, password produksi, serta Access Key dan Secret Key AWS S3, sehingga data rahasia dan infrastruktur server dapat dibobol dan disalahgunakan oleh pihak tidak berwenang saat kode di-push ke repositori publik/tim, yang seharusnya seluruh nilai sensitif tersebut dikosongkan atau diganti dengan nilai placeholder dummy.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
